datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BORROWER
  CUSTODIAN
}

enum ItemStatus {
  AVAILABLE
  ON_LOAN
}

enum RequestStatus {
  PENDING
  FULFILLED
}

enum LoanStatus {
  ACTIVE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(50)
  passwordHash String        @map("password_hash") @db.VarChar
  displayName  String        @map("display_name") @db.VarChar(100)
  role         Role
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  managedItems Item[]        @relation("ItemManagedBy")
  requests     LoanRequest[] @relation("BorrowerRequests")
  borrowedLoans Loan[]       @relation("BorrowerLoans")
  checkedOutLoans Loan[]     @relation("CustodianLoans")

  @@map("users")
}

model Item {
  id          String        @id @default(uuid()) @db.Uuid
  assetTag    String        @unique @map("asset_tag") @db.VarChar(30)
  name        String        @db.VarChar(100)
  description String        @default("") @db.Text
  status      ItemStatus    @default(AVAILABLE)
  managedBy   String        @map("managed_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  manager     User          @relation("ItemManagedBy", fields: [managedBy], references: [id], onDelete: Restrict)
  requests    LoanRequest[]
  loans       Loan[]

  @@map("items")
}

model LoanRequest {
  id          String        @id @default(uuid()) @db.Uuid
  itemId      String        @map("item_id") @db.Uuid
  borrowerId  String        @map("borrower_id") @db.Uuid
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  fulfilledAt DateTime?     @map("fulfilled_at") @db.Timestamptz

  item        Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrower    User          @relation("BorrowerRequests", fields: [borrowerId], references: [id], onDelete: Restrict)
  loan        Loan?

  @@map("loan_requests")
}

model Loan {
  id           String        @id @default(uuid()) @db.Uuid
  itemId       String        @map("item_id") @db.Uuid
  borrowerId   String        @map("borrower_id") @db.Uuid
  requestId    String        @unique @map("request_id") @db.Uuid
  custodianId  String        @map("custodian_id") @db.Uuid
  status       LoanStatus    @default(ACTIVE)
  checkedOutAt DateTime      @default(now()) @map("checked_out_at") @db.Timestamptz

  item         Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrower     User          @relation("BorrowerLoans", fields: [borrowerId], references: [id], onDelete: Restrict)
  request      LoanRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  custodian    User          @relation("CustodianLoans", fields: [custodianId], references: [id], onDelete: Restrict)

  @@map("loans")
}

model RevokedToken {
  jti       String   @id @db.VarChar
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("revoked_tokens")
}
