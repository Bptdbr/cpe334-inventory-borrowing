# Application Environment (development | test | production)
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) - Required in all environments
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_dev?schema=public"

# Authentication & JWT (Secret must be at least 32 characters) - Required in all environments
JWT_SECRET="demo-secret-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN_MINUTES=60

# Demo Seed Password (Used by db:seed)
# In development/test: defaults to "demo_password_123" if unset.
# In production: MUST be provided explicitly and cannot be "demo_password_123".
SEED_DEMO_PASSWORD="demo_password_123"

# Frontend / CORS & Static Distribution
# In development: frontend runs on port 5173.
# In production: single container serves frontend static dist and API on the same origin (PORT).
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000"

# Optional path override for static frontend dist in container/production (default: ../frontend/dist)
CLIENT_DIST_PATH=""
