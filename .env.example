# Application Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_dev?schema=public"

# Authentication & JWT (Secret must be at least 32 characters)
JWT_SECRET="demo-secret-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN_MINUTES=60

# Demo Seed Password (Synthetic data only, used by db:seed)
SEED_DEMO_PASSWORD="demo_password_123"

# Frontend / CORS
CORS_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000"

